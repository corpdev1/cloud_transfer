# ── Google Drive ──────────────────────────────────────────────────────────────
# Path to the OAuth 2.0 client JSON downloaded from Google Cloud Console
GDRIVE_OAUTH_CLIENT_FILE=credentials/oauth_client.json

# Where the OAuth token is cached after first login
GDRIVE_TOKEN_FILE=credentials/token.json

# Drive folder ID to transfer (leave as "root" to transfer everything)
# Get the folder ID from the URL: drive.google.com/drive/folders/<FOLDER_ID>
GDRIVE_FOLDER_ID=root

# ── Hetzner Object Storage (S3-compatible) ────────────────────────────────────
# Endpoint: https://<location>.your-objectstorage.com
# Locations: fsn1 (Falkenstein), nbg1 (Nuremberg), hel1 (Helsinki)
S3_ENDPOINT_URL=https://fsn1.your-objectstorage.com
S3_ACCESS_KEY=your_access_key_here
S3_SECRET_KEY=your_secret_key_here
S3_BUCKET=your-bucket-name

# Optional prefix (folder) inside the bucket
S3_PREFIX=gdrive

# ── Transfer settings ─────────────────────────────────────────────────────────
# Temp directory for in-flight downloads (needs free space = PARALLEL_WORKERS × largest_file)
TEMP_DIR=/tmp/drivetocloud

# Number of parallel file transfers.
# - 4–6   for home connections (100–500 Mbps)
# - 6–10  for fast connections (500 Mbps–1 Gbps) or servers
# - >10   not useful: Google Drive API starts throttling with 429s,
#          triggering retries that erase the parallelism gain.
PARALLEL_WORKERS=4

# Chunk size for download streaming and S3 multipart upload (MB)
CHUNK_SIZE_MB=64

# Max retry attempts per file before marking it as failed
MAX_RETRIES=3

# SQLite state file (tracks progress for resume)
STATE_DB=transfer_state.db
